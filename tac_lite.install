<?php

/**
 * @file
 *   Installation functions for tac_lite.
 */

/**
 * Implements hook_install().
 *
 * Ensure that tac_lite hooks are invoked after taxonomy module hooks.
 */
function tac_lite_install() {
  $taxonomy_weight = db_query("SELECT weight FROM {system} WHERE name = 'taxonomy'")->fetchField();
  $num_updated = db_update('system')
  ->fields(array(
    'weight' => $taxonomy_weight + 9,
  ))
  ->condition('name', 'tac_lite')
  ->execute();

  // Note that it is not necessary to rebuild the node access table here, as
  // that will be done when module settings are saved.
}

/**
 * Convert variables to config.
 */
function tac_lite_update_1000() {
  $schemes = update_variable_get('tac_lite_schemes', 1);
  // Convert variables to config.
  $config = config('tac_lite.settings');
  $config->set('categories', update_variable_get('tac_lite_categories', [0]));
  $config->set('schemes', $schemes);
  for ($i = 1; $i <= $schemes; $i++) {
    $config->set('config_scheme_' . $i, update_variable_get('tac_lite_config_scheme_' . $i));
    $config->set('grants_scheme_' . $i, update_variable_get('tac_lite_grants_scheme_' . $i));
    update_variable_del('tac_lite_config_scheme_' . $i);
    update_variable_del('tac_lite_grants_scheme_' . $i);
  }
  $config->save();
  update_variable_del('tac_lite_categories');
  update_variable_del('tac_lite_schemes');
}

/**
 * Fix role grants for existing schemes.
 */
function tac_lite_update_1001() {
  $config = config('tac_lite.settings');

  // Get the role id (machine name) and role names (labels).
  $roles = user_roles();

  // Flip so we can lookup the role name.
  $role_name_map = array_flip($roles);

  // Get the number of schemes.
  $schemes = $config->get('schemes');

  // Loop through the schemes.
  for ($i = 1; $i <= $schemes; $i++) {
    $grants_scheme = $config->get('grants_scheme_' . $i);
    $grants_scheme_changed = FALSE;

    // Check for each role name in the scheme.
    foreach ($role_name_map as $role_name => $role_id) {
      if (isset($grants_scheme[$role_name])) {
        // If the scheme is defined using role names rather than role ids then
        // replace with role id.
        $role_grants = $grants_scheme[$role_name];
        unset($grants_scheme[$role_name]);
        $grants_scheme[$role_id] = $role_grants;
        $grants_scheme_changed = TRUE;
      }
    }

    // If the scheme has changed set the config using the new definition.
    if ($grants_scheme_changed) {
      $config->set('grants_scheme_' . $i, $grants_scheme);
    }
  }
  $config->save();
}

/**
 * Set defaults for term_parents and term_children settings.
 */
function tac_lite_update_1002() {
  $config = config('tac_lite.settings');
  $schemes = $config->get('schemes');
  for ($i = 1; $i <= $schemes; $i++) {
    $config->set('config_scheme_' . $i . '.term_parents', 0);
    $config->set('config_scheme_' . $i . '.term_children', 0);
  }
  $config->save();
}

/**
 * Implements hook_update_last_removed().
 */
function tac_lite_update_last_removed() {
  return 7002;
}
